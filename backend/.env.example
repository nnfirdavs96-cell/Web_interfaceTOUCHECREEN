PROJECT_NAME=Hikvision Access Platform
ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://hikv:hikv@postgres:5432/hikv
REDIS_URL=redis://redis:6379/0

SECRET_KEY=change-me-please-32-bytes-min-aaaaaaaaaaaaaaaa
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost,http://localhost:5173

HIKVISION_MODE=mock

# MediaMTX — live-видео камер (RTSP→WebRTC/HLS). true в production с камерами.
MEDIAMTX_ENABLED=false
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_HLS_PATH=/hls
MEDIAMTX_WEBRTC_PATH=/webrtc

SEED_ADMIN_EMAIL=admin@hikvision.dev
SEED_ADMIN_PASSWORD=admin

# Создать демо-данные при первом запуске (1 организация, 10 сотрудников, события за 7 дней)
DEMO_SEED=true
